# Copy this file to `.env` and fill in your MySQL credentials (must match cPanel → MySQL® Databases).

# Show PHP errors in the browser while troubleshooting. Set false when the site works.
APP_DEBUG=false

# On most shared hosts MySQL is reached via `localhost` (not 127.0.0.1).
DB_HOST=localhost
DB_NAME=youraccount_dbname
DB_USER=youraccount_dbuser
DB_PASSWORD=your_password_here

# Password with # or spaces — quote it:
# DB_PASSWORD="my#secret pass"

# URL folder segment after your domain (no slashes).
# Leave empty if the site is at the domain root (public_html = this project).
# BASE_PATH=
# Or use a subfolder name:
# BASE_PATH=energy-providers
BASE_PATH=

# Shown in footer / header when web_settings has no address|email|tel (legacy DB dumps).
SITE_ADDRESS=Fuhrmannsweg 2, 07607 Eisenberg, Germany
SITE_EMAIL=info@asindex.org
# SITE_TEL=

# Local dev only: allow plain HTTP (disables lib/require_https.php redirect).
# FORCE_HTTP=true

# If SSL terminates at Cloudflare/load balancer and you get redirect loops, set:
# HTTPS_TRUST_PROXY=true
